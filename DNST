#!/bin/bash

# SSHPlus/DNST installer with Ubuntu 20 compatibility and defensive error handling.
# The original installer downloads additional modules from external URLs.

clear >/dev/null 2>&1 || true

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;33m[\033[1;31mError\033[1;33m] \033[1;37m- \033[1;33mYou need to run this script as root.\033[0m"
    exit 1
fi

# Preserve the original obfuscated locations used by the upstream installer.
_lnk=$(echo 't1:e#n.5s0ul&p4hs$s.0729t9p$&8i&&9r7827c032:3s' | sed -e 's/[^a-z.]//ig' | rev)
_Ink=$(echo '/3×u3#s87r/l32o4×c1a×l1/83×l24×i0b×' | sed -e 's/[^a-z/]//ig')
_1nk=$(echo '/3×u3#s×87r/83×l2×4×i0b×' | sed -e 's/[^a-z/]//ig')
mkdir -p "$_Ink" "$_1nk" "$HOME" 2>/dev/null || {
    echo -e "\033[1;31mUnable to create the installer working directories.\033[0m"
    exit 1
}
cd "$HOME" || exit 1

# External sources used by the installer.
UPSTREAM_BASE='https://raw.githubusercontent.com/AAAAAEXQOSyIpN2JZ0ehUQ/SSHPLUS-MANAGER-FREE/master'
DNST_BIN_URL='https://raw.githubusercontent.com/powermx/dnstt/main/dns-server'

run_action() {
    local action="$1"
    if [[ "$action" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && declare -F "$action" >/dev/null 2>&1; then
        "$action"
    else
        bash -c "$action"
    fi
}

fun_bar() {
    local first_action="$1"
    local second_action="${2:-}"
    local status_file="$HOME/.dnst_action_status"
    rm -f "$HOME/fim" "$status_file" 2>/dev/null
    (
        local rc=0
        run_action "$first_action" || rc=$?
        if [[ -n "$second_action" ]]; then
            run_action "$second_action" || rc=$?
        fi
        printf '%s\n' "$rc" > "$status_file"
        touch "$HOME/fim"
    ) >/dev/null 2>&1 &

    command -v tput >/dev/null 2>&1 && [[ -n "${TERM:-}" ]] && tput civis >/dev/null 2>&1 || true
    echo -ne "  \033[1;33mPLEASE WAIT \033[1;37m- \033[1;33m["
    while true; do
        for ((i=0; i<18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.1
        done
        if [[ -e "$HOME/fim" ]]; then
            rm -f "$HOME/fim" 2>/dev/null
            break
        fi
        echo -e "\033[1;33m]"
        sleep 1
        command -v tput >/dev/null 2>&1 && [[ -n "${TERM:-}" ]] && tput cuu1 >/dev/null 2>&1 && tput dl1 >/dev/null 2>&1 || true
        echo -ne "  \033[1;33mPLEASE WAIT \033[1;37m- \033[1;33m["
    done
    command -v tput >/dev/null 2>&1 && [[ -n "${TERM:-}" ]] && tput cnorm >/dev/null 2>&1 || true
    local rc=0
    [[ -s "$status_file" ]] && rc=$(cat "$status_file")
    rm -f "$status_file" 2>/dev/null
    if [[ "$rc" -ne 0 ]]; then
        echo -e "\033[1;33m] - WARNING: one installation step returned status $rc.\033[0m"
        return "$rc"
    fi
    echo -e "\033[1;33m] \033[1;37m-\033[1;32m OK!\033[0m"
    return 0
}

fetch_file() {
    local url="$1"
    local destination="$2"
    local temporary="${destination}.tmp.$$"
    rm -f "$temporary" 2>/dev/null
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 --connect-timeout 10 --max-time 120 "$url" -o "$temporary" >/dev/null 2>&1
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$temporary" "$url" >/dev/null 2>&1
    else
        echo -e "\033[1;31mNeither curl nor wget is installed.\033[0m"
        rm -f "$temporary" 2>/dev/null
        return 1
    fi
    if [[ ! -s "$temporary" ]]; then
        rm -f "$temporary" 2>/dev/null
        return 1
    fi
    mv -f "$temporary" "$destination"
    return 0
}

verif_key() {
    mkdir -p "$_Ink" "$_1nk"
    if [[ ! -f "$_Ink/list" ]]; then
        echo -e "\n\033[1;31mUnable to download the installer file list.\033[0m"
        return 1
    fi
    chmod +x "$_Ink/list" >/dev/null 2>&1 || true
    return 0
}

systemverify() {
    mkdir -p /etc/SSHPlus /bin 2>/dev/null || return 1
    if [[ -f /etc/ssh/sshd_config ]]; then
        cp /etc/ssh/sshd_config "/etc/ssh/sshd_back_principal_$(date +%d-%m-%Y_%H%M%S).conf" >/dev/null 2>&1 || true
    fi
    printf '%s\n' '/bin/menu' > /bin/h
    chmod +x /bin/h >/dev/null 2>&1 || true
    rm -f "$HOME/credits" 2>/dev/null
    fetch_file "$UPSTREAM_BASE/credits" "$HOME/credits" || echo -e "\033[1;33mCredits download skipped.\033[0m"
    cat > /bin/sshplus <<'EOF'
#!/bin/bash
exec bash <(curl -fsSL https://raw.githubusercontent.com/karyan779/DNST/main/DNST)
EOF
    chmod +x /bin/sshplus >/dev/null 2>&1 || true
    for version in V3 V2 V1; do
        local menu_file="/bin/menu${version}"
        if ! fetch_file "$UPSTREAM_BASE/Install/Skin_Plus/menu${version}/Install" "$menu_file"; then
            echo -e "\033[1;33mMenu ${version} download skipped.\033[0m"
        else
            chmod +x "$menu_file" >/dev/null 2>&1 || true
        fi
    done
    return 0
}

prepare_slowdns() {
    local slowdns_dir='/etc/SSHPlus/dns'
    local slowdns_bin="$slowdns_dir/dns-server"
    mkdir -p "$slowdns_dir" || return 1
    case "$(uname -m)" in
        x86_64|amd64) ;;
        *)
            echo -e "\033[1;31mUnsupported CPU architecture for SlowDNS: $(uname -m). This build requires x86_64.\033[0m"
            return 1
            ;;
    esac
    echo -e "\033[1;36mPreparing the SlowDNS server binary...\033[0m"
    if ! fetch_file "$DNST_BIN_URL" "$slowdns_bin"; then
        echo -e "\033[1;31mSlowDNS binary download failed. Check DNS/network access and try again.\033[0m"
        return 1
    fi
    chmod 755 "$slowdns_bin" || return 1
    if [[ ! -s "$slowdns_dir/server.key" || ! -s "$slowdns_dir/server.pub" ]]; then
        rm -f "$slowdns_dir/server.key" "$slowdns_dir/server.pub" 2>/dev/null
        "$slowdns_bin" -gen-key -privkey-file "$slowdns_dir/server.key" -pubkey-file "$slowdns_dir/server.pub" >/dev/null 2>&1 || true
    fi
    if [[ ! -s "$slowdns_dir/server.key" || ! -s "$slowdns_dir/server.pub" ]]; then
        echo -e "\033[1;31mSlowDNS key generation failed; server.pub was not created.\033[0m"
        return 1
    fi
    chmod 600 "$slowdns_dir/server.key" >/dev/null 2>&1 || true
    chmod 644 "$slowdns_dir/server.pub" >/dev/null 2>&1 || true
    return 0
}

patch_slowdns_module() {
    local slowdns_module='/bin/slow_dns'
    if [[ -f "$slowdns_module" ]]; then
        sed -i "s#sshplus.net/scripts/slow-dns/dns-server#$DNST_BIN_URL#g" "$slowdns_module" >/dev/null 2>&1 || true
        chmod 755 "$slowdns_module" >/dev/null 2>&1 || true
    fi
}

# Header
printf '\033[1;31m════════════════════════════════════════════════════\033[0m\n'
printf '%40s%s%-12s\n' 'WELCOME TO SSHPLUS MANAGER' '' ''
printf '\033[1;31m════════════════════════════════════════════════════\033[0m\n\n'
printf '%s\n' 'ATTENTION: THIS SCRIPT installs network, system, and user-management tools.'
printf '%s\n\n' 'It changes system files, firewall rules, services, and scheduled tasks.'
printf '%s' 'DO YOU WANT TO CONTINUE? [Y/N]: '
read -r -e -i y resp
if [[ "$resp" =~ ^([nN]|no|NO)$ ]]; then
    echo 'Cancelled.'
    exit 0
fi

# Download and validate the upstream module list before making system changes.
echo -e "\n\033[1;36mVERIFYING FILE LIST...\033[0m"
rm -f "$_Ink/list" 2>/dev/null
if ! fetch_file "$UPSTREAM_BASE/Install/list" "$_Ink/list" || ! verif_key; then
    echo -e "\033[1;31mThe upstream module list could not be downloaded. Nothing else was changed.\033[0m"
    exit 1
fi
echo -e "\033[1;32mVALID FILE LIST!\033[0m"

if [[ -f "$HOME/usuarios.db" ]]; then
    echo -e "\n\033[1;33mA user database (usuarios.db) was found.\033[0m"
    echo '1) Keep current database'
    echo '2) Create a new database'
    printf 'Option [1/2]: '
    read -r -e -i 1 optiondb
else
    optiondb=1
fi
if [[ "$optiondb" == '2' || ! -f "$HOME/usuarios.db" ]]; then
    awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd 2>/dev/null | grep -v '^nobody' > "$HOME/usuarios.db" || :
fi

printf '\n%s\n' 'UPDATING SYSTEM'
fun_attlist() {
    apt-get update -y >/dev/null 2>&1 || return 1
    mkdir -p /usr/share/.plus || return 1
    printf 'crz: %s\n' "$(date)" > /usr/share/.plus/.plus || return 1
}
if ! fun_bar fun_attlist; then
    echo -e "\033[1;31mPackage index update failed. Check the VPS network and apt sources.\033[0m"
    exit 1
fi

printf '\n%s\n' 'INSTALLING PACKAGES'
inst_pct() {
    local packages=(bc screen nano unzip lsof net-tools dos2unix nload jq curl figlet python3 python3-pip)
    local package
    for package in "${packages[@]}"; do
        apt-get install -y "$package" >/dev/null 2>&1 || echo -e "\033[1;33mOptional package skipped: $package\033[0m"
    done
    if command -v pip3 >/dev/null 2>&1; then
        pip3 install --disable-pip-version-check --no-input speedtest-cli >/dev/null 2>&1 || true
    fi
    return 0
}
fun_bar inst_pct || true

if command -v ufw >/dev/null 2>&1; then
    ufw allow 443/tcp >/dev/null 2>&1 || true
    ufw allow 80/tcp >/dev/null 2>&1 || true
    ufw allow 3128/tcp >/dev/null 2>&1 || true
    ufw allow 8799/tcp >/dev/null 2>&1 || true
    ufw allow 8080/tcp >/dev/null 2>&1 || true
fi

printf '\n%s\n' 'PREPARING SLOWDNS'
if ! prepare_slowdns; then
    echo -e "\033[1;31mSlowDNS preparation failed. Installation stopped before final configuration.\033[0m"
    exit 1
fi

printf '\n%s\n' 'INSTALLING MODULES'
run_upstream_list() {
    bash "$_Ink/list" "$_lnk" "$_Ink" "$_1nk" "${key:-}"
}
if ! fun_bar run_upstream_list; then
    echo -e "\033[1;31mThe upstream module setup failed. Installation stopped before final cleanup.\033[0m"
    exit 1
fi
patch_slowdns_module

if ! systemverify; then
    echo -e "\033[1;33mSome system integration files could not be created.\033[0m"
fi

# Avoid the original rm warning when the script was downloaded as DNST.
rm -f "$HOME/Plus" "$HOME/fim" 2>/dev/null || true
: > "$HOME/.bash_history" 2>/dev/null || true
history -c 2>/dev/null || true

clear >/dev/null 2>&1 || true
echo -e "\033[1;32m • INSTALLATION COMPLETED •\033[0m"
echo -e "\033[1;33mMAIN COMMAND: \033[1;32mmenu\033[0m"
echo -e "\033[1;33mMORE INFORMATION (TELEGRAM): \033[1;37m@AAAAAEXQOSyIpN2JZ0ehUQ\033[0m"
