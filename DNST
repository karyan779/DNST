patch_slowdns_module() {
    local slowdns_module="/bin/slow_dns"
    local replacement_url="https://raw.githubusercontent.com/powermx/dnstt/main/dns-server"
    if [ -f "$slowdns_module" ]; then
        sed -i "s#sshplus.net/scripts/slow-dns/dns-server#$replacement_url#g" "$slowdns_module"
        chmod 755 "$slowdns_module"
    fi
}

