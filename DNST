prepare_slowdns() {
    local slowdns_dir="/etc/SSHPlus/dns"
    local slowdns_bin="$slowdns_dir/dns-server"
    local slowdns_url="https://raw.githubusercontent.com/powermx/dnstt/main/dns-server"

    mkdir -p "$slowdns_dir"
    case "$(uname -m)" in
        x86_64|amd64) ;;
        *)
            echo -e "\033[1;31mUnsupported CPU architecture for the SlowDNS binary: $(uname -m)\033[0m"
            return 1
            ;;
    esac

    echo -e "\033[1;36mPreparing the SlowDNS server binary...\033[0m"
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 --connect-timeout 10 "$slowdns_url" -o "$slowdns_bin"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$slowdns_bin" "$slowdns_url"
    else
        echo -e "\033[1;31mNeither curl nor wget is available.\033[0m"
        return 1
    fi
    chmod 755 "$slowdns_bin"
    if [ ! -s "$slowdns_bin" ]; then
        echo -e "\033[1;31mSlowDNS binary download failed.\033[0m"
        return 1
    fi
    return 0
}

if ! prepare_slowdns; then
    echo -e "\033[1;31mSlowDNS preparation failed. Installation stopped safely.\033[0m"
